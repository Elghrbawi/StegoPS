{
  "manifest_version": 2,
  "name": "STEGOPS",
  "version": "2.0.0",
  "description": "Hide & detect secret messages in WhatsApp images using DCT steganography. Survives WhatsApp compression.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "STEGOPS",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "web_accessible_resources": ["icons/*.svg"]
}
